# Backend Settings
PROJECT_NAME="Exam Portal"
API_V1_STR="/api"
SECRET_KEY="replace-this-with-a-super-secret-cryptographic-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL / SQLite for local development)
DATABASE_URL="sqlite+aiosqlite:///./exam_portal.db"
# For PostgreSQL in production or docker:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/exam_portal"

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Proctoring Settings
FACE_MISSING_THRESHOLD_SECONDS=1.5
MULTIPLE_FACES_THRESHOLD_SECONDS=2.0
LOOKING_AWAY_THRESHOLD_SECONDS=2.5
PHONE_DETECTED_THRESHOLD_SECONDS=1.0
CAMERA_BLOCKED_THRESHOLD_SECONDS=2.0

# Risk Signal Weights (0 to 100 max sum scale)
WEIGHT_PHONE_DETECTED=45
WEIGHT_MULTIPLE_FACES=35
WEIGHT_CAMERA_BLOCKED=30
WEIGHT_FACE_NOT_DETECTED=20
WEIGHT_LOOKING_AWAY=10
